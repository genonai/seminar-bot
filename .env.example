SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
LLM_API_KEY=sk-or-v1-...
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5
VLM_MODEL=anthropic/claude-sonnet-4.5
# VLM도 GenOS로 쓰려면 (예: serving 689 = gemini-3-flash-preview):
# VLM_API_BASE_URL=https://genos.genon.ai/api/gateway/rep/serving/689/v1
# VLM_API_KEY=<serving 689 키>
# VLM_MODEL=                # 비우면 /v1/models 자동 발견
WEAVIATE_URL=http://localhost:8080
# Embedding — 사내 GenOS (OpenAI 호환). serving_id가 URL에 포함됨.
EMBEDDING_API_BASE_URL=https://genos.genon.ai/api/gateway/rep/serving/10/v1
EMBEDDING_API_KEY=
# EMBEDDING_MODEL 비워두면 /v1/models 로 자동 발견. 명시하려면 serving_rev_id(예: 559).
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
