SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
LLM_API_KEY=sk-or-v1-...
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v3.2
# VLM은 LLM과 다른 모델/엔드포인트 가능. 미설정 시 LLM_* 폴백.
VLM_MODEL=google/gemini-2.5-flash
# VLM_API_BASE_URL=     # 비우면 LLM_API_BASE_URL 폴백
# VLM_API_KEY=          # 비우면 LLM_API_KEY 폴백
# Embedding — OpenRouter의 OpenAI 임베딩 (사내 GenOS 사용하려면 BASE_URL/KEY 교체).
EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=             # LLM_API_KEY와 동일 값 (OpenRouter 단일 키)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DB_PATH=/var/lib/seminar-bot/seminar.db
CHANNEL_ID=C0B1XSR0YNN
# 자동 공지(월요일 알림, 사이클 추첨, 연기 결과, 자료 제출 등) 동시 발송할 채널 ID CSV.
# 비워두면 CHANNEL_ID 한 곳만. 예: 본사 엔지니어 채널 추가:
BROADCAST_CHANNELS=C0B1XSR0YNN,C09P52U025S
ADMIN_USER_IDS=U07GFTZ6LM8,U01UPAEG4F5
TIMEZONE=Asia/Seoul
LOG_LEVEL=INFO
